# Local server configuration. Copy to .env and fill only the values you own.
# This file is a template; .env is ignored by Git and is never sent to the browser.
TRADE_MODE=manual
HOST=localhost
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/trade
WEB_PORT=3001

# Required for live Kite. Use a long random local value; do not reuse your password.
TRADE_MASTER_KEY=
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://localhost:3000/api/brokers/kite/callback
